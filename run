#!/usr/bin/env bash
# Convenience launcher: finds the project venv and runs the diagnostic runner.
#   ./run --preflight --host reachy-mini.local
#   ./run --host reachy-mini.local
set -e
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REACHY_FACE_RESULTS_DIR="${REACHY_FACE_RESULTS_DIR:-${HERE}/../../runs/face_following/results}"
for py in "$HERE/../../.venv/bin/python" "$HERE/.venv/bin/python" "$(command -v python3 || true)"; do
  [ -x "$py" ] && exec "$py" "$HERE/diagnostic_runner.py" "$@"
done
echo "no python found (expected $HERE/../../.venv/bin/python)" >&2
exit 1
